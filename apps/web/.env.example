# Copy to .env.local for development and replace all CHANGE_ME values.
# Never commit real secrets or production endpoints.

DATABASE_URL=postgresql://tts_user:CHANGE_ME@127.0.0.1:5432/tts_raizhost
BETTER_AUTH_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
AUTH_KMS_KEY=CHANGE_ME_WITH_64_HEX_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
TTS_PRIMARY_URL=http://localhost:8001
TTS_FALLBACK_URL=http://localhost:8000
DATA_DIR=./data
BOOKS_DIR=./data/books
CACHE_DIR=./data/cache
